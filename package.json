{
  "name": "juna",
  "version": "0.1.0",
  "devDependencies": {
    "@ast-grep/napi": "^0.45.3",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@modelcontextprotocol/server": "^2.1.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.2.0",
    "gpt-tokenizer": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "description": "A minimal Pi coding agent profile that wraps Jev (TypeSafe System One) around the context pipeline, starting with pruning tool output to what the current task needs.",
  "engines": {
    "node": ">=22.6"
  },
  "files": ["extensions", "config", "bin", "README.md", "LICENSE"],
  "keywords": ["pi", "pi-extension", "context", "typesafe", "jev", "system-one"],
  "license": "MIT",
  "pi": {
    "extensions": ["extensions/jev-prune.ts"]
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test test/",
    "check": "bun run typecheck && bun test test/"
  },
  "type": "module"
}
